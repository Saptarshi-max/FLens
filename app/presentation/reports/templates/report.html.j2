<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>FLENS Scan Report</title>
  <style>
    :root {
      --bg: #f7f4ef;
      --panel: #ffffff;
      --ink: #1f2a37;
      --muted: #5b6470;
      --accent: #0f766e;
      --danger: #b91c1c;
      --warn: #b45309;
      --ok: #166534;
      --border: #d8d0c5;
    }

    body {
      margin: 0;
      font-family: "Source Sans 3", "Segoe UI", sans-serif;
      background: radial-gradient(circle at top right, #e6f7f5, var(--bg) 55%);
      color: var(--ink);
      line-height: 1.55;
    }

    .container {
      max-width: 980px;
      margin: 0 auto;
      padding: 2rem 1.25rem 3rem;
    }

    .hero {
      background: linear-gradient(135deg, #ecfeff, #fefce8);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 1.5rem;
      box-shadow: 0 8px 30px rgba(15, 23, 42, 0.08);
      animation: reveal 360ms ease-out;
    }

    h1, h2 {
      margin: 0 0 0.65rem;
      font-family: "Merriweather", Georgia, serif;
    }

    .risk {
      font-size: 1.3rem;
      font-weight: 700;
      margin-top: 0.75rem;
    }

    .risk-low { color: var(--ok); }
    .risk-medium { color: var(--warn); }
    .risk-high, .risk-critical { color: var(--danger); }

    .panel {
      margin-top: 1rem;
      background: var(--panel);
      border-radius: 12px;
      border: 1px solid var(--border);
      padding: 1rem 1.2rem;
      animation: reveal 460ms ease-out;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    th, td {
      text-align: left;
      padding: 0.55rem;
      border-bottom: 1px solid var(--border);
    }

    th {
      color: var(--muted);
      font-weight: 600;
    }

    .empty {
      color: var(--muted);
      font-style: italic;
    }

    .note {
      margin: 0.55rem 0;
    }

    .doc-list {
      margin: 0;
      padding-left: 1.2rem;
    }

    .doc-list li {
      margin: 0.35rem 0;
    }

    .mono {
      font-family: "Consolas", "Courier New", monospace;
    }

    @keyframes reveal {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>
</head>
<body>
  <main class="container">
    <section class="hero">
      <h1>FLENS Firmware Security Report</h1>
      <div class="risk risk-{{ scan_result.risk_score.lower() }}">Risk Score: {{ scan_result.risk_score }}</div>
    </section>

    <section class="panel">
      <h2>Detected Components</h2>
      {% if scan_result.components %}
      <table>
        <thead>
          <tr><th>Name</th><th>Version</th><th>CPE</th><th>Confidence</th><th>Evidence</th></tr>
        </thead>
        <tbody>
        {% for component in scan_result.components %}
          <tr><td>{{ component.name }}</td><td>{{ component.version }}</td><td>{{ component.cpe or 'Unresolved' }}</td><td>{{ component.confidence }}</td><td>{% for item in component.evidence %}<div><span class="mono">{{ item.source }}</span>: {{ item.detail }} <span class="mono">({{ item.path }})</span></div>{% else %}No version evidence available.{% endfor %}</td></tr>
        {% endfor %}
        </tbody>
      </table>
      {% else %}
      <p class="empty">No known components detected.</p>
      {% endif %}
    </section>

    <section class="panel">
      <h2>Vulnerabilities</h2>
      {% if scan_result.vulnerabilities %}
      <table>
        <thead>
          <tr><th>CVE</th><th>Severity</th><th>Range / Match</th><th>Source</th><th>Description</th><th>Evidence</th></tr>
        </thead>
        <tbody>
        {% for vulnerability in scan_result.vulnerabilities %}
          <tr>
            <td>{{ vulnerability.cve_id }}</td>
            <td>{{ vulnerability.severity }}</td>
            <td>{{ vulnerability.affected_range }} / {{ vulnerability.match_result }}</td>
            <td>{{ vulnerability.data_source }}</td>
            <td>{{ vulnerability.description }}</td>
            <td>{% for item in vulnerability.evidence %}<div><span class="mono">{{ item.source }}</span>: {{ item.detail }}</div>{% else %}No evidence available.{% endfor %}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
      {% else %}
      <p class="empty">No matching CVEs found.</p>
      {% endif %}
    </section>

    <section class="panel">
      <h2>Risk Score Breakdown</h2>
      <p class="note">Critical Vulnerabilities: {{ risk_breakdown.critical }}</p>
      <p class="note">High Vulnerabilities: {{ risk_breakdown.high }}</p>
      <p class="note">Medium Vulnerabilities: {{ risk_breakdown.medium }}</p>
      <p class="note">Low Vulnerabilities: {{ risk_breakdown.low }}</p>
      <p class="note">Calculated Score: {{ risk_breakdown.total }}</p>
      <p class="note"><strong>Overall Risk: {{ risk_breakdown.overall }}</strong></p>
    </section>

    <section class="panel">
      <h2>Vulnerability Detection Explanation</h2>
      <p class="note">FLENS identifies vulnerabilities through:</p>
      <p class="note">1. Component detection</p>
      <p class="note">2. Version identification</p>
      <p class="note">3. Vulnerability database correlation</p>
      <p class="note">FLENS detects known vulnerabilities based on available vulnerability intelligence.</p>
      <p class="note">Absence of findings does not imply absence of vulnerabilities.</p>
    </section>

    <section class="panel">
      <h2>Transparency &amp; Methodology</h2>
      <ul class="doc-list">
        {% for item in methodology_links %}
        <li>
          {{ item.label }}:
          {% if item.url %}
          <a href="{{ item.url }}">{{ item.path }}</a>
          {% else %}
          <span class="mono">{{ item.path }}</span>
          {% endif %}
        </li>
        {% endfor %}
      </ul>
    </section>

    <section class="panel">
      <h2>Disclaimer</h2>
      <p class="note">FLENS identifies known vulnerabilities and security indicators based on detected software components and available vulnerability intelligence.</p>
      <p class="note">The absence of findings does not imply the absence of vulnerabilities.</p>
      <p class="note">New, undisclosed, proprietary, or currently unknown vulnerabilities may not be detected.</p>
    </section>
  </main>
</body>
</html>
