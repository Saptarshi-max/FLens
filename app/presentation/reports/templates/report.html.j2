<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>FLENS Scan Report</title>
  <style>
    :root {
      --bg: #f7f4ef;
      --panel: #ffffff;
      --ink: #1f2a37;
      --muted: #5b6470;
      --accent: #0f766e;
      --danger: #b91c1c;
      --warn: #b45309;
      --ok: #166534;
      --border: #d8d0c5;
    }

    body {
      margin: 0;
      font-family: "Source Sans 3", "Segoe UI", sans-serif;
      background: radial-gradient(circle at top right, #e6f7f5, var(--bg) 55%);
      color: var(--ink);
      line-height: 1.55;
    }

    .container {
      max-width: 980px;
      margin: 0 auto;
      padding: 2rem 1.25rem 3rem;
    }

    .hero {
      background: linear-gradient(135deg, #ecfeff, #fefce8);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 1.5rem;
      box-shadow: 0 8px 30px rgba(15, 23, 42, 0.08);
      animation: reveal 360ms ease-out;
    }

    h1, h2 {
      margin: 0 0 0.65rem;
      font-family: "Merriweather", Georgia, serif;
    }

    .risk {
      font-size: 1.3rem;
      font-weight: 700;
      margin-top: 0.75rem;
    }

    .risk-low { color: var(--ok); }
    .risk-medium { color: var(--warn); }
    .risk-high, .risk-critical { color: var(--danger); }

    .panel {
      margin-top: 1rem;
      background: var(--panel);
      border-radius: 12px;
      border: 1px solid var(--border);
      padding: 1rem 1.2rem;
      animation: reveal 460ms ease-out;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    th, td {
      text-align: left;
      padding: 0.55rem;
      border-bottom: 1px solid var(--border);
    }

    th {
      color: var(--muted);
      font-weight: 600;
    }

    .empty {
      color: var(--muted);
      font-style: italic;
    }

    .note {
      margin: 0.55rem 0;
    }

    .doc-list {
      margin: 0;
      padding-left: 1.2rem;
    }

    .doc-list li {
      margin: 0.35rem 0;
    }

    .mono {
      font-family: "Consolas", "Courier New", monospace;
    }

    @keyframes reveal {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>
</head>
<body>
  <main class="container">
    <section class="hero">
      <h1>FLENS Firmware Security Report</h1>
      <div class="risk risk-{{ scan_result.risk_score.lower() }}">Risk Score: {{ scan_result.risk_score }}</div>
    </section>

    {% if inventory %}
    <section class="panel">
      <h2>Inventory Coverage and Scan Diagnostics</h2>
      <p class="note">Components: {{ inventory.stats.merged_components }} merged from {{ inventory.stats.raw_components_discovered }} raw discoveries.</p>
      <p class="note">Version coverage: {{ '%.0f'|format(inventory.version_coverage * 100) }}% · CPE coverage: {{ '%.0f'|format(inventory.cpe_coverage * 100) }}%</p>
      <p class="note">ELF: {{ inventory.stats.elf_files_examined }} examined; {{ inventory.stats.elf_executables_discovered }} executables; {{ inventory.stats.elf_libraries_discovered }} libraries.</p>
      <p class="note">Extraction placeholders: {{ inventory.stats.extraction_placeholder_entries }} · Open/read failures: {{ inventory.stats.open_read_failures }} · Unreadable files: {{ inventory.stats.elf_unreadable_files }}.</p>
      {% if inventory.stats.elf_discovery_limit_reached %}<p class="note"><strong>Warning:</strong> ELF discovery limit reached; inventory is incomplete.</p>{% endif %}
      {% if inventory.version_coverage < 0.8 or inventory.cpe_coverage < 0.5 %}<p class="note"><strong>Coverage warning:</strong> Low version or CPE coverage reduces assessment confidence. No CVEs found does not necessarily mean the firmware is vulnerability-free.</p>{% endif %}
      {% if inventory.stats.extraction_placeholder_entries %}<p class="note">Extraction placeholders may represent Linux links not preserved by the host environment.</p>{% endif %}
      {% if inventory.diagnostics %}<p class="note">Representative failures:</p><ul>{% for path, type, reason in inventory.diagnostics %}<li class="mono">{{ reason }}: {{ type }} ({{ path }})</li>{% endfor %}</ul>{% endif %}
      {% if inventory.busybox %}{% set applets = inventory.busybox.metadata|selectattr('0', 'equalto', 'applet')|list %}<p class="note">BusyBox applets recognised: {{ applets|length }} {% for item in applets[:20] %}<span class="mono">{{ item[1] }}</span> {% endfor %}</p>{% endif %}
    </section>
    {% endif %}

    {% if identity %}
    <section class="panel">
      <h3>Identity Resolution</h3>
      <p class="note">Resolved {{ identity.stats.resolved }} · Excluded {{ identity.stats.excluded }} · Ambiguous {{ identity.stats.ambiguous }} · Unsupported {{ identity.stats.unsupported }} · Insufficient evidence {{ identity.stats.insufficient_evidence }}</p>
      <p class="note">Governed CPE components: {{ identity.stats.governed_cpe_components }} ({{ '%.0f'|format(identity.coverage * 100) }}%) · Legacy fallback: {{ identity.stats.legacy_cpe_components }} · No CPE: {{ identity.stats.no_cpe_components }}</p>
      {% if identity.stats.ambiguous %}<p class="note">Ambiguous identities require manual review.</p>{% endif %}
      {% if identity.stats.unsupported %}<p class="note">Unsupported identities are outside the current resolver policy.</p>{% endif %}
      {% if identity.stats.insufficient_evidence %}<p class="note">Insufficient evidence prevents safe canonical mapping.</p>{% endif %}
      {% if identity.stats.legacy_cpe_components %}<p class="note">Legacy CPE fallback is ungoverned compatibility behaviour.</p>{% endif %}
      {% if identity.coverage < 0.5 %}<p class="note">Low governed-CPE coverage limits vulnerability-assessment confidence.</p>{% endif %}
      <table>
        <thead>
          <tr><th>Observed</th><th>Canonical</th><th>Status / Rule</th><th>CPE source</th><th>Evidence</th></tr>
        </thead>
        <tbody>
        {% for record in identity.records %}
          <tr>
            <td>{{ record.name }} {{ record.version }}</td>
            <td>{{ record.canonical_vendor or '-' }} / {{ record.canonical_product or '-' }}</td>
            <td>{{ record.status }} / {{ record.rule_id }} ({{ record.confidence }})</td>
            <td>
              {{ record.cpe_source }}{% if record.cpe_source == 'legacy' %} (legacy fallback){% endif %}
              {% for cpe in record.governed_cpes %}<div class="mono">{{ cpe }}</div>{% endfor %}
              {% if record.omitted_cpes %}<div>{{ record.omitted_cpes }} CPE candidates omitted.</div>{% endif %}
            </td>
            <td>
              {% for item in record.evidence %}<div><span class="mono">{{ item.source }}</span>: {{ item.detail }}</div>{% else %}none{% endfor %}
              {% if record.omitted_evidence %}<div>{{ record.omitted_evidence }} evidence items omitted.</div>{% endif %}
            </td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
      {% if identity.omitted %}<p class="note">{{ identity.omitted }} identity records omitted by the report limit.</p>{% endif %}
      <p class="note">Excluded components are intentionally omitted from canonical mapping and are not scan failures.</p>
    </section>
    {% endif %}

    <section class="panel">
      <h2>Detected Components</h2>
      {% if scan_result.components %}
      <table>
        <thead>
          <tr><th>Name</th><th>Version</th><th>CPE</th><th>Confidence</th><th>Evidence</th></tr>
        </thead>
        <tbody>
        {% for component in scan_result.components %}
          <tr><td>{{ component.name }}</td><td>{{ component.version }}</td><td>{{ component.cpe or 'Unresolved' }}</td><td>{{ component.confidence }}</td><td>{% for item in component.evidence %}<div><span class="mono">{{ item.source }}</span>: {{ item.detail }} <span class="mono">({{ item.path }})</span></div>{% else %}No version evidence available.{% endfor %}</td></tr>
        {% endfor %}
        </tbody>
      </table>
      {% else %}
      <p class="empty">No known components detected.</p>
      {% endif %}
    </section>

    <section class="panel">
      <h2>Vulnerabilities</h2>
      {% if scan_result.vulnerabilities %}
      <table>
        <thead>
          <tr><th>CVE</th><th>Severity</th><th>Range / Match</th><th>Source</th><th>Description</th><th>Evidence</th></tr>
        </thead>
        <tbody>
        {% for vulnerability in scan_result.vulnerabilities %}
          <tr>
            <td>{{ vulnerability.cve_id }}</td>
            <td>{{ vulnerability.severity }}</td>
            <td>{{ vulnerability.affected_range }} / {{ vulnerability.match_result }}</td>
            <td>{{ vulnerability.data_source }}</td>
            <td>{{ vulnerability.description }}</td>
            <td>{% for item in vulnerability.evidence %}<div><span class="mono">{{ item.source }}</span>: {{ item.detail }}</div>{% else %}No evidence available.{% endfor %}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
      {% else %}
      <p class="empty">No matching CVEs found.</p>
      {% endif %}
    </section>

    <section class="panel">
      <h2>Risk Score Breakdown</h2>
      <p class="note">Critical Vulnerabilities: {{ risk_breakdown.critical }}</p>
      <p class="note">High Vulnerabilities: {{ risk_breakdown.high }}</p>
      <p class="note">Medium Vulnerabilities: {{ risk_breakdown.medium }}</p>
      <p class="note">Low Vulnerabilities: {{ risk_breakdown.low }}</p>
      <p class="note">Calculated Score: {{ risk_breakdown.total }}</p>
      <p class="note"><strong>Overall Risk: {{ risk_breakdown.overall }}</strong></p>
    </section>

    <section class="panel">
      <h2>Vulnerability Detection Explanation</h2>
      <p class="note">FLENS identifies vulnerabilities through:</p>
      <p class="note">1. Component detection</p>
      <p class="note">2. Version identification</p>
      <p class="note">3. Vulnerability database correlation</p>
      <p class="note">FLENS detects known vulnerabilities based on available vulnerability intelligence.</p>
      <p class="note">Absence of findings does not imply absence of vulnerabilities.</p>
    </section>

    <section class="panel">
      <h2>Transparency &amp; Methodology</h2>
      <ul class="doc-list">
        {% for item in methodology_links %}
        <li>
          {{ item.label }}:
          {% if item.url %}
          <a href="{{ item.url }}">{{ item.path }}</a>
          {% else %}
          <span class="mono">{{ item.path }}</span>
          {% endif %}
        </li>
        {% endfor %}
      </ul>
    </section>

    <section class="panel">
      <h2>Disclaimer</h2>
      <p class="note">FLENS identifies known vulnerabilities and security indicators based on detected software components and available vulnerability intelligence.</p>
      <p class="note">The absence of findings does not imply the absence of vulnerabilities.</p>
      <p class="note">New, undisclosed, proprietary, or currently unknown vulnerabilities may not be detected.</p>
    </section>
  </main>
</body>
</html>
